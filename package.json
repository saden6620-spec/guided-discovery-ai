{
  "name": "guided-discovery-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository foundation for the Guided Discovery AI platform.",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.4.0 <12"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write . && python -m ruff format .",
    "format:check": "prettier --check . && python -m ruff format --check .",
    "lint": "pnpm lint:js && pnpm lint:python",
    "lint:js": "eslint .",
    "lint:python": "python -m ruff check .",
    "typecheck": "tsc --project tsconfig.node.json",
    "test": "pnpm test:javascript && pnpm test:python",
    "test:javascript": "jest --runInBand",
    "test:python": "python -m pytest",
    "test:e2e": "playwright test",
    "validate": "pnpm check && pnpm test:e2e",
    "docker:config": "docker compose config --quiet",
    "docker:up": "docker compose up --build --detach",
    "docker:down": "docker compose down --remove-orphans"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.1",
    "eslint": "10.7.0",
    "globals": "16.4.0",
    "jest": "30.4.0",
    "prettier": "3.9.0",
    "turbo": "2.9.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.2"
  }
}
