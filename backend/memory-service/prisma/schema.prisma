generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MemoryCategory {
  id                 String   @id @db.Uuid
  key                String   @unique @db.VarChar(64)
  displayName        String   @map("display_name") @db.VarChar(100)
  defaultSensitivity String   @map("default_sensitivity") @db.VarChar(32)
  isSystem           Boolean  @default(true) @map("is_system")
  isActive           Boolean  @default(true) @map("is_active")
  version            Int
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)
  memories           Memory[]

  @@map("memory_categories")
}

model Memory {
  id                      String          @id @db.Uuid
  ownerId                 String          @map("owner_id") @db.Uuid
  categoryId              String          @map("category_id") @db.Uuid
  currentVersionId        String?         @map("current_version_id") @db.Uuid
  state                   String          @db.VarChar(32)
  importance              Decimal         @db.Decimal(4, 3)
  sensitivity             String          @db.VarChar(32)
  verificationStatus      String          @map("verification_status") @db.VarChar(32)
  permissionPolicyRef     String          @map("permission_policy_ref") @db.VarChar(128)
  permissionPolicyVersion Int             @map("permission_policy_version")
  retentionPolicyRef      String          @map("retention_policy_ref") @db.VarChar(64)
  userConfirmedAt         DateTime?       @map("user_confirmed_at") @db.Timestamptz(3)
  archivedAt              DateTime?       @map("archived_at") @db.Timestamptz(3)
  deletionVersion         Int             @default(0) @map("deletion_version")
  deletedAt               DateTime?       @map("deleted_at") @db.Timestamptz(3)
  purgeAfter              DateTime?       @map("purge_after") @db.Timestamptz(3)
  purgeStatus             String          @map("purge_status") @db.VarChar(32)
  legalHoldRef            String?         @map("legal_hold_ref") @db.VarChar(128)
  createdAt               DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @map("updated_at") @db.Timestamptz(3)
  version                 Int
  category                MemoryCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions                MemoryVersion[]

  @@index([ownerId, state, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId, categoryId, state, createdAt(sort: Desc)])
  @@index([purgeStatus, purgeAfter])
  @@index([ownerId, deletionVersion])
  @@map("memories")
}

model MemoryVersion {
  id                         String   @id @db.Uuid
  memoryId                   String   @map("memory_id") @db.Uuid
  versionNumber              Int      @map("version_number")
  titleCiphertext            Bytes    @map("title_ciphertext")
  summaryCiphertext          Bytes    @map("summary_ciphertext")
  purposeCiphertext          Bytes    @map("purpose_ciphertext")
  sourceType                 String   @map("source_type") @db.VarChar(32)
  sourceRefCiphertext        Bytes?   @map("source_ref_ciphertext")
  originatedAt               DateTime? @map("originated_at") @db.Timestamptz(3)
  confidence                 Decimal  @db.Decimal(4, 3)
  verificationStatus         String   @map("verification_status") @db.VarChar(32)
  correctionReasonCiphertext Bytes?   @map("correction_reason_ciphertext")
  encryptionState            String   @map("encryption_state") @db.VarChar(32)
  encryptionKeyRef           String   @map("encryption_key_ref") @db.VarChar(256)
  actorId                    String   @map("actor_id") @db.Uuid
  createdAt                  DateTime @map("created_at") @db.Timestamptz(3)
  memory                     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, versionNumber])
  @@map("memory_versions")
}

model MemoryLink {
  id               String    @id @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  sourceMemoryId   String    @map("source_memory_id") @db.Uuid
  targetMemoryId   String    @map("target_memory_id") @db.Uuid
  relationshipType String    @map("relationship_type") @db.VarChar(32)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  version          Int

  @@index([sourceMemoryId, deletedAt])
  @@index([targetMemoryId, deletedAt])
  @@map("memory_links")
}

model MemoryDeletionLedger {
  memoryId       String   @id @map("memory_id") @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  deletionVersion Int    @map("deletion_version")
  deletedAt      DateTime @map("deleted_at") @db.Timestamptz(3)
  purgeAfter     DateTime @map("purge_after") @db.Timestamptz(3)
  legalHoldRef   String?  @map("legal_hold_ref") @db.VarChar(128)
  purgeStatus    String   @map("purge_status") @db.VarChar(32)
  lastErrorCode  String?  @map("last_error_code") @db.VarChar(64)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([purgeStatus, purgeAfter])
  @@map("memory_deletion_ledger")
}

model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(128)
  eventVersion   Int       @map("event_version")
  subjectType    String    @map("subject_type") @db.VarChar(64)
  subjectId      String    @map("subject_id") @db.Uuid
  subjectVersion Int       @map("subject_version")
  partitionKey   String    @map("partition_key") @db.VarChar(128)
  payload        Json
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  availableAt    DateTime  @map("available_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(64)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)

  @@index([availableAt, eventId])
  @@map("outbox_events")
}

model InboxEvent {
  consumerName  String    @map("consumer_name") @db.VarChar(64)
  eventId       String    @map("event_id") @db.Uuid
  subjectId     String    @map("subject_id") @db.Uuid
  subjectVersion Int      @map("subject_version")
  receivedAt    DateTime  @map("received_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  resultCode    String    @map("result_code") @db.VarChar(64)

  @@id([consumerName, eventId])
  @@index([receivedAt])
  @@map("inbox_events")
}

model DeadLetterEvent {
  id              String    @id @db.Uuid
  originalEventId String    @map("original_event_id") @db.Uuid
  consumerName    String    @map("consumer_name") @db.VarChar(64)
  eventType       String    @map("event_type") @db.VarChar(128)
  eventVersion    Int       @map("event_version")
  payload         Bytes
  failureCode     String    @map("failure_code") @db.VarChar(64)
  attemptCount    Int       @map("attempt_count")
  firstFailedAt   DateTime  @map("first_failed_at") @db.Timestamptz(3)
  lastFailedAt    DateTime  @map("last_failed_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("dead_letter_events")
}

model LegalHold {
  id             String    @id @db.Uuid
  authorityRef   String    @map("authority_ref") @db.VarChar(128)
  reasonCategory String    @map("reason_category") @db.VarChar(64)
  actorId        String    @map("actor_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(3)
  releasedBy     String?   @map("released_by") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  version        Int
  resources      LegalHoldResource[]

  @@index([expiresAt, releasedAt])
  @@map("legal_holds")
}

model LegalHoldResource {
  holdId       String   @map("hold_id") @db.Uuid
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String   @map("resource_id") @db.Uuid
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  hold         LegalHold @relation(fields: [holdId], references: [id], onDelete: Cascade)

  @@id([holdId, resourceType, resourceId])
  @@index([resourceType, resourceId])
  @@map("legal_hold_resources")
}

model IdempotencyRecord {
  id             String    @id @db.Uuid
  environment    String    @db.VarChar(32)
  principalId    String    @map("principal_id") @db.Uuid
  service        String    @db.VarChar(64)
  method         String    @db.VarChar(16)
  routeTemplate  String    @map("route_template") @db.VarChar(256)
  keyHash        String    @map("key_hash") @db.VarChar(64)
  requestHash    String    @map("request_hash") @db.VarChar(64)
  state          String    @db.VarChar(16)
  responseStatus Int?      @map("response_status")
  responseBody   Bytes?    @map("response_body")
  responseHeaders Json?    @map("response_headers")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)

  @@unique([environment, principalId, service, method, routeTemplate, keyHash])
  @@index([expiresAt])
  @@map("idempotency_records")
}
