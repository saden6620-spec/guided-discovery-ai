generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Destination {
  id                String    @id @db.Uuid
  ownerId           String?   @map("owner_id") @db.Uuid
  provider          String    @db.VarChar(64)
  providerReference String    @map("provider_reference") @db.VarChar(256)
  name              String    @db.VarChar(200)
  latitude          Decimal   @db.Decimal(10, 7)
  longitude         Decimal   @db.Decimal(10, 7)
  timezone          String    @db.VarChar(64)
  accessibility     Json
  sourceVersion     Int       @map("source_version")
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  version           Int

  @@index([provider, providerReference])
  @@map("destinations")
}

model Route {
  id                    String    @id @db.Uuid
  ownerId               String?   @map("owner_id") @db.Uuid
  provider              String    @db.VarChar(64)
  providerReference     String    @map("provider_reference") @db.VarChar(256)
  originDestinationId   String    @map("origin_destination_id") @db.Uuid
  destinationId         String    @map("destination_id") @db.Uuid
  travelMode            String    @map("travel_mode") @db.VarChar(16)
  distanceMeters        Int       @map("distance_meters")
  durationSeconds       Int       @map("duration_seconds")
  polylineCiphertext    Bytes     @map("polyline_ciphertext")
  accessibility         Json
  validFrom             DateTime  @map("valid_from") @db.Timestamptz(3)
  validUntil            DateTime? @map("valid_until") @db.Timestamptz(3)
  sourceVersion         Int       @map("source_version")
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)
  version               Int

  @@index([provider, providerReference])
  @@index([destinationId, validUntil])
  @@map("routes")
}

model Trip {
  id              String    @id @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  state           String    @db.VarChar(16)
  destinationId   String    @map("destination_id") @db.Uuid
  activeSessionId String?   @unique @map("active_session_id") @db.Uuid
  startedAt       DateTime  @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  outcome         String?   @db.VarChar(16)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  purgeAfter      DateTime? @map("purge_after") @db.Timestamptz(3)
  version         Int

  @@index([ownerId, state])
  @@map("trips")
}

model NavigationSession {
  id            String    @id @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  routeId       String    @map("route_id") @db.Uuid
  destinationId String    @map("destination_id") @db.Uuid
  travelMode    String    @map("travel_mode") @db.VarChar(16)
  state         String    @db.VarChar(16)
  startedAt     DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(3)
  stopReason    String?   @map("stop_reason") @db.VarChar(16)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  version       Int

  @@index([ownerId, state])
  @@index([tripId, state])
  @@map("navigation_sessions")
}

model VisitedLocation {
  id                    String    @id @db.Uuid
  tripId                String    @map("trip_id") @db.Uuid
  ownerId               String    @map("owner_id") @db.Uuid
  destinationId         String?   @map("destination_id") @db.Uuid
  coordinatesCiphertext Bytes     @map("coordinates_ciphertext")
  visitedAt             DateTime  @map("visited_at") @db.Timestamptz(3)
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)
  version               Int

  @@index([tripId, visitedAt, id])
  @@map("visited_locations")
}

model Landmark {
  id                    String    @id @db.Uuid
  ownerId               String?   @map("owner_id") @db.Uuid
  destinationId         String?   @map("destination_id") @db.Uuid
  provider              String    @db.VarChar(64)
  providerReference     String    @map("provider_reference") @db.VarChar(256)
  name                  String    @db.VarChar(200)
  coordinatesCiphertext Bytes?    @map("coordinates_ciphertext")
  accessibility         Json
  sourceVersion         Int       @map("source_version")
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)
  version               Int

  @@index([provider, providerReference])
  @@map("landmarks")
}

model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(128)
  eventVersion   Int       @map("event_version")
  subjectType    String    @map("subject_type") @db.VarChar(64)
  subjectId      String    @map("subject_id") @db.Uuid
  subjectVersion Int       @map("subject_version")
  partitionKey   String    @map("partition_key") @db.VarChar(128)
  payload        Json
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(3)
  availableAt    DateTime  @map("available_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(64)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)

  @@index([availableAt, eventId])
  @@map("outbox_events")
}

model InboxEvent {
  consumerName   String    @map("consumer_name") @db.VarChar(64)
  eventId        String    @map("event_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  subjectVersion Int       @map("subject_version")
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  resultCode     String    @map("result_code") @db.VarChar(64)

  @@id([consumerName, eventId])
  @@index([receivedAt])
  @@map("inbox_events")
}

model DeadLetterEvent {
  id              String    @id @db.Uuid
  originalEventId String    @map("original_event_id") @db.Uuid
  consumerName    String    @map("consumer_name") @db.VarChar(64)
  eventType       String    @map("event_type") @db.VarChar(128)
  eventVersion    Int       @map("event_version")
  payload         Bytes
  failureCode     String    @map("failure_code") @db.VarChar(64)
  attemptCount    Int       @map("attempt_count")
  firstFailedAt   DateTime  @map("first_failed_at") @db.Timestamptz(3)
  lastFailedAt    DateTime  @map("last_failed_at") @db.Timestamptz(3)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("dead_letter_events")
}

model IdempotencyRecord {
  id              String    @id @db.Uuid
  environment     String    @db.VarChar(32)
  principalId     String    @map("principal_id") @db.Uuid
  service         String    @db.VarChar(64)
  method          String    @db.VarChar(16)
  routeTemplate   String    @map("route_template") @db.VarChar(256)
  keyHash         String    @map("key_hash") @db.VarChar(64)
  requestHash     String    @map("request_hash") @db.VarChar(64)
  state           String    @db.VarChar(16)
  responseStatus  Int?      @map("response_status")
  responseBody    Bytes?    @map("response_body")
  responseHeaders Json?     @map("response_headers")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)

  @@unique([environment, principalId, service, method, routeTemplate, keyHash])
  @@index([expiresAt])
  @@map("idempotency_records")
}
